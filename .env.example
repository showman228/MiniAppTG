# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# db — имя сервиса в docker compose; для запуска без докера поставь localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mini_app_db

# Админка (sqladmin) — ключ для подписи session-cookie
SECRET_KEY=change-me

